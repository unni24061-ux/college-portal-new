# Copy this file to .env and fill in your values. Local dev works with none of them.

# ---- Django ----
DEBUG=True
SECRET_KEY=use-a-long-random-string-in-production

# ---- Production database (Vercel / Neon PostgreSQL) ----
# Commented out => falls back to local SQLite.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# ---- Durable media storage (profile images on serverless) ----
# Set all three to route media through Cloudinary. Without them, local
# development uses the filesystem and serverless uploads will not persist.
# CLOUDINARY_CLOUD_NAME=your-cloud
# CLOUDINARY_API_KEY=your-key
# CLOUDINARY_API_SECRET=your-secret